{
  "name": "pynote-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "postinstall": "cp node_modules/lms-widget-manager/dist/lms-widget-manager.iife.js public/ || echo 'Ensure lms-widget-manager is built'"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}